// Нижний плеер.

import { Theme } from "theme.slint";
import { Icons, Icon, BarButton, Cover, ArtistLinks, ExplicitMark } from "widgets.slint";
import { App, T } from "state.slint";
import { VolumePopup } from "popups.slint";

component TransportButton inherits BarButton {
    grow-on-hover: true;
    ink-active: Theme.controls-color-secondary-text-enabled-variant;
}

component BarPlayButton inherits TransportButton {
    width: 40px;
    height: 40px;
    icon-size: 40px;
    icon: App.playing ? Icons.pause-filled : Icons.play-filled;
    ink: Theme.logo-color-primary-player;
    ink-hover: self.ink;
    ink-off: self.ink;
    clicked => { App.play-pause(); }
}

// Нижний плеер. Фон — цвет обложки (hsl с яркостью 20%), прогресс закрашивает фон слева направо.
export component PlayerBar inherits Rectangle {
    property <float> progress: App.duration > 0 ? App.position / App.duration : 0;
    property <float> drag-progress: -1;
    property <float> shown: drag-progress >= 0 ? drag-progress : progress;
    property <brush> ink: #ffffff80;
    property <brush> ink-off: #ffffff14;
    property <bool> on: App.has-track;
    property <length> c: self.width / 2;
    property <bool> vol-open: vol-btn.hovered || vol-pop.hovered;
    property <bool> dragging: drag-progress >= 0;
    // Полоса и бегунок видны при наведении на плеер или на зону перемотки.
    property <bool> show-progress: on && (bar-ta.has-hover || seek-ta.has-hover || dragging);
    property <float> rail-alpha: show-progress ? 1 : 0;
    animate rail-alpha { duration: App.motion && !dragging ? Theme.duration-transition : 0ms; easing: ease; }
    property <float> tip-alpha: on && (seek-ta.has-hover || dragging) ? 1 : 0;
    animate tip-alpha { duration: App.motion && !dragging ? Theme.duration-transition : 0ms; easing: ease; }
    property <float> hover-progress: max(0, min(1, seek-ta.mouse-x / root.width));

    inner := Rectangle {
        border-radius: Theme.radius-size-l;
        border-width: 1px;
        border-color: #ffffff0a;
        background: on ? App.tint : Theme.background-color-primary-enabled-player;
        clip: true;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }

        if on: Rectangle {
            x: 0;
            width: parent.width * shown;
            height: parent.height;
            background: #ffffff0d;
        }
        // Полоса прогресса сверху: видна при наведении на плеер.
        if rail-alpha > 0: Rectangle {
            y: 0;
            height: 4px;
            background: #ffffff.with-alpha(0.12 * root.rail-alpha);
            Rectangle {
                x: 0;
                width: parent.width * shown;
                background: seek-ta.has-hover || dragging ? Theme.controls-color-primary-default-enabled : #ffffff29;
                opacity: root.rail-alpha;
            }
        }

        bar-ta := TouchArea {
            mouse-cursor: on ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if on {
                    App.open-fullscreen(0);
                }
            }

            if on: Cover {
                x: 9px;
                y: 8px;
                width: 64px;
                height: 64px;
                radius: Theme.radius-size-s;
                background: #ffffff14;
                source: App.cover;
                property <float> reveal: cover-ta.has-hover ? 1 : 0;
                animate reveal { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
                if reveal > 0: Rectangle {
                    opacity: reveal;
                    background: #00000033;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #1a1a1ae6;
                        Icon { source: Icons.fullscreen; size: 24px; colorize: #ffffff; }
                    }
                }
                cover-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { App.open-fullscreen(0); }
                }
            }

            if on: Rectangle {
                x: 81px;
                y: 19px;
                width: c - 188px - self.x - 16px;
                height: 20px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    title := Text {
                        text: App.title;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff;
            if title-ta.has-hover: Rectangle {
                x: 0;
                y: (parent.height + parent.font-size) / 2 + 1px;
                width: min(parent.width, parent.preferred-width);
                height: 1px;
                background: parent.color;
            }
                        title-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-current-album(); }
                        }
                    }
                    if App.track-version != "": Text {
                        text: App.track-version;
                        overflow: elide;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        font-size: Theme.font-size-label-m;
                        font-weight: 500;
                        color: #ffffff80;
                    }
                    if App.track-explicit: ExplicitMark { y: 1px; ink: #ffffff80; }
                    more := Rectangle {
                        width: 36px;
                        height: 20px;
                        Icon {
                            source: Icons.more-small;
                            size: 20px;
                            colorize: more-ta.has-hover || App.menu-open ? #ffffffe6 : #ffffff80;
                            animate colorize { duration: App.motion ? Theme.duration-transition : 0ms; easing: ease; }
                        }
                        more-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { App.open-track-menu(more.absolute-position.x + 18px, more.absolute-position.y); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // Каждый исполнитель — отдельная ссылка.
            if on: ArtistLinks {
                x: 81px;
                y: 40px;
                width: min(self.content-width, c - 188px - self.x - 16px);
                height: 20px;
                names: App.artist-list;
                ink: #ffffff80;
                ink-hover: #ffffffe6;
                clicked(i) => { App.open-current-artist(i); }
            }

            BarButton { x: c - 188px; y: 18px; width: 44px; height: 44px; icon: App.disliked ? Icons.disliked : Icons.dislike; tip: T.t("Не нравится"); enabled: on; clicked => { App.dislike(); } }
            TransportButton { x: c - 128px; y: 24px; icon: Icons.shuffle; tip: T.t("Перемешать"); enabled: on && !App.is-wave; active: App.shuffle; ink-hover: self.ink; clicked => { App.toggle-shuffle(); } }
            TransportButton { x: c - 80px; y: 18px; width: 44px; height: 44px; icon: Icons.prev-small; icon-size: 20px; tip: T.t("Предыдущая песня"); enabled: on && App.can-prev; clicked => { App.prev(); } }
            BarPlayButton { x: c - 32px; y: 20px; }
            TransportButton { x: c + 12px; y: 18px; width: 44px; height: 44px; icon: Icons.next-small; icon-size: 20px; tip: T.t("Следующая песня"); enabled: on; clicked => { App.next(); } }
            TransportButton { x: c + 72px; y: 24px; icon: App.repeat == 2 ? Icons.repeat-one : Icons.repeat; tip: App.repeat == 2 ? T.t("Повтор трека") : T.t("Повтор"); enabled: on; active: App.repeat > 0; ink-hover: self.ink; clicked => { App.cycle-repeat(); } }
            BarButton { x: c + 120px; y: 18px; width: 44px; height: 44px; icon: App.liked ? Icons.liked : Icons.like; tip: T.t("Нравится"); enabled: on; clicked => { App.like(); } }

            // По высоте кнопок справа (y 24, 32 px), чтобы надпись стояла на их середине.
            if on && App.track-format != "": Text {
                x: parent.width - 201px - self.width;
                y: 24px;
                height: 32px;
                text: App.track-format;
                vertical-alignment: center;
                font-size: Theme.font-size-label-s;
                font-weight: 500;
                color: #ffffff66;
            }
            BarButton { x: parent.width - 193px; y: 24px; icon: Icons.lyrics; tip: T.t("Текст песни"); enabled: on && App.has-lyrics; clicked => { App.open-fullscreen(2); } }
            BarButton { x: parent.width - 145px; y: 24px; icon: Icons.queue; tip: T.t("Очередь"); enabled: on; clicked => { App.open-fullscreen(1); } }
            BarButton { x: parent.width - 97px; y: 24px; icon: Icons.settings; tip: T.t("Настройки звука"); active: App.eq-open; clicked => { App.eq-open = !App.eq-open; } }
            vol-btn := BarButton {
                x: parent.width - 49px;
                y: 24px;
                icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
                scroll-volume: true;
                active: false;
                ink: vol-open ? #ffffffe6 : #ffffff80;
                clicked => { App.toggle-mute(); }
            }
        }
    }

    // Перемотка: зона 16 px по верхнему краю (6 px над плеером и 10 px внутри), тянуть можно по всей ширине.
    seek-ta := TouchArea {
        x: 0;
        y: -6px;
        width: root.width;
        height: 16px;
        enabled: on;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-progress >= 0 {
                App.seek(root.hover-progress * App.duration);
                root.drag-progress = -1;
            }
            if e.kind == PointerEventKind.cancel { root.drag-progress = -1; }
        }
        moved => {
            if self.pressed {
                root.drag-progress = max(0, min(1, self.mouse-x / root.width));
            }
        }
    }

    if rail-alpha > 0: Rectangle {
        opacity: root.rail-alpha;
        x: root.width * shown - self.width / 2;
        y: 2px - self.height / 2;
        width: 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.controls-color-primary-default-enabled;
    }
    if tip-alpha > 0: Rectangle {
        opacity: root.tip-alpha;
        property <float> at: dragging ? shown : hover-progress;
        x: max(0px, min(root.width - self.width, root.width * at - self.width / 2));
        y: -32px;
        width: time.preferred-width + 16px;
        height: 24px;
        border-radius: 12px;
        background: #000000b3;
        time := Text {
            text: App.format-time(at * App.duration) + " / " + App.format-time(App.duration);
            font-size: Theme.font-size-label-xs;
            font-weight: 500;
            color: #ffffffe6;
        }
    }

    vol-pop := VolumePopup {
        x: root.width - 49px + 16px - self.width / 2;
        y: 24px - self.height;
        open: vol-open;
    }
}

// Кнопка мини-плеера: значок без подложки, под курсором — светлый круг и белый значок.
component MiniButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: ta.has-hover && enabled ? #ffffff1a : #ffffff00;
    animate background { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
    Icon {
        source: root.icon;
        size: root.icon-size;
        colorize: !enabled ? #ffffff29 : ta.has-hover ? #ffffff : #ffffffb3;
        animate colorize { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Мини-плеер: окно ужато до карточки поверх всех окон. Детали — из полноэкранного плеера:
// фон в цвете обложки (`App.tint`), обложка с тенью, жёлтая круглая «играть», полоса
// прогресса, которая под курсором желтеет. Тянется за любое место, двойной клик или
// клик по обложке возвращает обычное окно, колёсико меняет громкость.
component MiniVolumeSlider inherits Rectangle {
    property <float> level: max(0, min(1, App.volume));
    property <length> inset: 5px;
    property <length> rail-width: self.width - 2 * inset;
    height: 32px;

    Rectangle {
        x: root.inset;
        y: (parent.height - self.height) / 2;
        width: root.rail-width;
        height: 4px;
        border-radius: 2px;
        background: #ffffff33;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.level;
            height: parent.height;
            border-radius: 2px;
            background: Theme.controls-color-primary-default-enabled;
        }
    }
    Rectangle {
        x: root.inset + root.rail-width * root.level - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: volume-ta.has-hover || volume-ta.pressed ? Theme.controls-color-primary-default-enabled : #ffffff;
    }
    if volume-ta.has-hover || volume-ta.pressed: Text {
        y: -16px;
        height: 16px;
        text: round(root.level * 100) + "%";
        font-size: Theme.font-size-label-xs;
        color: #ffffff;
        horizontal-alignment: center;
    }
    volume-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                App.set-volume(max(0, min(1, (self.mouse-x - root.inset) / root.rail-width)));
            }
        }
        moved => {
            if self.pressed {
                App.set-volume(max(0, min(1, (self.mouse-x - root.inset) / root.rail-width)));
            }
        }
        scroll-event(e) => {
            App.set-volume(App.wheel-volume(e.delta-y));
            accept
        }
    }
}

export component MiniPlayer inherits Rectangle {
    property <bool> on: App.has-track;
    property <float> progress: App.duration > 0 ? App.position / App.duration : 0;
    property <float> drag: -1;
    property <float> shown: drag >= 0 ? drag : progress;
    background: on ? App.tint : Theme.background-color-primary-enabled-player;
    animate background { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }

    ta := TouchArea {
        property <bool> dragging;
        moved => {
            if self.pressed && !dragging && (abs(self.mouse-x - self.pressed-x) >= 4px || abs(self.mouse-y - self.pressed-y) >= 4px) {
                dragging = true;
                App.drag-window();
            }
        }
        changed pressed => { if !self.pressed { dragging = false; } }
        double-clicked => { App.toggle-mini(); }
        scroll-event(e) => {
            App.set-volume(App.wheel-volume(e.delta-y));
            accept
        }

        // Обложка с тенью, как постер полноэкранного плеера; под курсором — «развернуть».
        Rectangle {
            x: 12px;
            y: 12px;
            width: 88px;
            height: 88px;
            border-radius: Theme.radius-size-m;
            background: on ? #ffffff14 : transparent;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: on ? #00000052 : #00000000;
            if on: Cover {
                radius: Theme.radius-size-m;
                source: App.cover;
            }
            // Без трека — значок приложения.
            if !on: Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("../packaging/icons/128.png");
                image-fit: contain;
            }
            property <float> reveal: cover-ta.has-hover ? 1 : 0;
            animate reveal { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
            Rectangle {
                visible: parent.reveal > 0;
                opacity: parent.reveal;
                border-radius: Theme.radius-size-m;
                background: #00000066;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: #1a1a1ae6;
                    Icon { source: Icons.fullscreen; size: 20px; colorize: #ffffff; }
                }
            }
            cover-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { App.toggle-mini(); }
            }
        }

        // Название и исполнители; справа оставляем место под кнопки окна.
        Text {
            x: 116px;
            y: 15px;
            width: parent.width - self.x - 80px;
            height: 22px;
            text: on ? App.title : App.app-name;
            color: #ffffff;
            overflow: elide;
            vertical-alignment: center;
            font-size: Theme.font-size-label-l;
            font-weight: 500;
        }
        Text {
            x: 116px;
            y: 37px;
            width: parent.width - self.x - 16px;
            height: 18px;
            // При перемотке вместо исполнителей — время под курсором.
            text: !on ? T.t("Моя волна") : root.seeking ? App.format-time(root.seek-at * App.duration) + " / " + App.format-time(App.duration) : App.artists;
            color: #ffffff80;
            overflow: elide;
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
        }

        // Кнопки: лайк, назад, «играть», вперёд; громкость — у правого края.
        MiniButton {
            x: 110px;
            y: 66px;
            icon: App.liked ? Icons.liked : Icons.like;
            enabled: on;
            clicked => { App.like(); }
        }
        MiniButton {
            x: 150px;
            y: 66px;
            icon: Icons.prev-small;
            enabled: on && App.can-prev;
            clicked => { App.prev(); }
        }
        // Жёлтая круглая, как в полноэкранном плеере. Без трека запускает «Мою волну».
        Rectangle {
            x: 190px;
            y: 62px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: play-ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.logo-color-primary-player;
            animate background { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
            transform-scale: play-ta.has-hover ? 1.05 : 1;
            animate transform-scale { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
            Icon { source: App.playing ? Icons.pause-m : Icons.play-m; size: 22px; colorize: #1a1a1ae6; }
            play-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.play-pause(); } }
        }
        MiniButton {
            x: 238px;
            y: 66px;
            icon: Icons.next-small;
            enabled: on;
            clicked => { App.next(); }
        }
        MiniVolumeSlider {
            x: parent.width - 120px;
            y: 66px;
            width: 68px;
        }
        MiniButton {
            x: parent.width - 44px;
            y: 66px;
            icon: App.volume <= 0 ? Icons.volume-off : Icons.volume;
            clicked => { App.toggle-mute(); }
        }

        // Возврат в большое окно доступен без наведения и клика по обложке.
        MiniButton {
            x: parent.width - 68px;
            y: 8px;
            icon: Icons.fullscreen;
            icon-size: 16px;
            clicked => { App.toggle-mini(); }
        }

        // Крестик закрытия: виден, пока курсор над окном.
        property <float> chrome: self.has-hover ? 1 : 0;
        animate chrome { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
        Rectangle {
            x: parent.width - 36px;
            y: 12px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            visible: parent.chrome > 0;
            opacity: parent.chrome;
            background: close-ta.has-hover ? #ffffff29 : #ffffff14;
            animate background { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
            Icon { source: Icons.close-xs; size: 16px; colorize: close-ta.has-hover ? #ffffff : #ffffffb3; }
            close-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.close(); } }
        }
    }

    // Прогресс по нижнему краю: тянуть можно по всей ширине, время — на месте исполнителей.
    property <bool> seeking: seek.has-hover || drag >= 0;
    property <float> seek-at: drag >= 0 ? drag : max(0, min(1, seek.mouse-x / seek.width));
    if on: Rectangle {
        y: parent.height - self.height;
        height: root.seeking ? 4px : 3px;
        background: #ffffff1f;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            background: root.seeking ? Theme.controls-color-primary-default-enabled : #ffffffcc;
            animate background { duration: (App.motion ? Theme.duration-transition : 0ms); easing: ease; }
        }
    }
    seek := TouchArea {
        y: parent.height - 10px;
        height: 10px;
        enabled: on && !App.loading && App.duration > 0;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag = max(0, min(1, self.mouse-x / self.width));
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag >= 0 {
                App.seek(root.drag * App.duration);
                root.drag = -1;
            }
            if e.kind == PointerEventKind.cancel { root.drag = -1; }
        }
        moved => {
            if self.pressed {
                root.drag = max(0, min(1, self.mouse-x / self.width));
            }
        }
    }
}
