// Альбом, плейлист и «Мне нравится»: шапка, список треков, редактирование плейлиста.

import { Theme } from "theme.slint";
import { Icons, Icon, Cover, Shimmer, NavArrows, Field, ArtistLinks, ScrollBar } from "widgets.slint";
import { T, App, TrackItem } from "state.slint";
import { TrackRow, AlbumTrackRow, Tab } from "rows.slint";

export component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 40px;
    width: text == "" ? 40px : label.preferred-width + 20px + 4px + 40px;
    border-radius: self.height / 2;
    background: primary
        ? (ta.pressed ? Theme.controls-color-primary-default-pressed : ta.has-hover ? Theme.controls-color-primary-default-hovered : Theme.controls-color-primary-default-enabled)
        : (ta.pressed ? Theme.controls-color-secondary-default-pressed : ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled);
    animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
    property <brush> ink: primary ? Theme.controls-color-primary-on-default-enabled : Theme.controls-color-secondary-on-default-enabled;
    Icon {
        x: text == "" ? 10px : 20px;
        source: icon;
        size: 20px;
        colorize: ink;
    }
    label := Text {
        x: 44px;
        text: root.text;
        font-size: Theme.font-size-label-s;
        font-weight: 500;
        color: ink;
        visible: root.text != "";
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component ListContent inherits TouchArea {
    property <bool> album: App.list-kind == "album";
    property <bool> likes: App.list-kind == "likes";
    property <bool> playlist: App.list-kind == "playlist";
    // Все популярные треки исполнителя: шапка как у «Мне нравится», без описания.
    property <bool> artist: App.list-kind == "artist";
    // «Мои дизлайки» и «Новые выпуски» у оригинала без обложки и кнопок: только заголовок,
    // у дизлайков ещё вкладки «Треки» / «Исполнители».
    property <bool> dislikes: App.list-kind == "dislikes";
    property <bool> plain: dislikes || App.list-kind == "plain";
    property <bool> short-head: likes || artist;
    property <length> pad: 25px;
    property <length> text-x: pad + 204px + 28px;
    // Шапка: подпись 85, название 100, строки метаданных, кнопки.
    // Описание плейлиста переносится (до трёх строк) и сдвигает всё, что ниже.
    property <length> desc-extra: playlist ? max(0px, desc.height - one-line.preferred-height) : 0px;
    property <bool> own: playlist && App.list-own;
    // Фокус у поля «Поиск трека». Нужен полосе прокрутки, а само поле внутри `if` и
    // отсюда не видно.
    property <bool> filter-focused;
    // В режиме правки поле названия на 8 px ниже обычного заголовка, всё ниже сдвигается на 8 px;
    // при правке описания под полем 120 px текста и кнопки «Сохранить» / «Отменить».
    property <length> edit-shift: App.list-edit == 1 ? 8px : 0px;
    property <length> buttons-y: album ? 219px : short-head ? 214px : App.list-edit == 2 ? 426px : 242px + desc-extra + edit-shift;
    property <length> search-y: buttons-y + (short-head ? 90px : 79px);
    // Подкаст, книга, сказка (`NonMusicContent` оригинала): под шапкой вкладки «О …» и списка.
    // Шапка кончается на 32 ниже обложки (`CommonAlbumPage_header`), у вкладки сверху 4, высота
    // 40 (по 10 сверху и снизу, `NonMusicContent_tab`), под полосой вкладок 16.
    property <bool> nonmusic: album && App.list-tabs.length > 0;
    property <bool> about: nonmusic && App.list-tab == 0;
    property <length> tabs-y: buttons-y + 98px;
    property <length> rows-y: dislikes ? 132px : plain ? 84px : nonmusic ? tabs-y + 40px + 16px : album ? buttons-y + 94px : search-y + 57px;
    // «Последние выпуски» (`LastEpisodes`): первые 5 выпусков подкаста под сведениями. Отступ
    // сверху 8 + 12, заголовок 26, под ним 16, внизу блока 16.
    property <int> last-count: about && App.list-podcast ? min(5, App.tracks.length) : 0;
    property <length> last-rows-y: rows-y + about-box.height + 8px + 12px + 26px + 16px;
    // Вкладка «О …» обычно короче списка выпусков: прокрутка не должна остаться за её концом.
    changed about => {
        flick.content-y = max(flick.content-y, min(0px, flick.height - flick.content-height));
    }
    property <int> hovered-last: about && self.has-hover && self.mouse-x >= row-x && self.mouse-x < self.width - 33px
        ? floor((self.mouse-y - flick.content-y - last-rows-y) / row-h) : -1;
    property <length> row-x: playlist && App.list-own ? pad + 12px : pad;
    property <length> row-h: 56px;
    // Заголовки «Диск N» — строки той же высоты между треками.
    property <int> disk-rows: App.list-disks.length;
    // Flickable передаёт нажатие с задержкой, поэтому строку под курсором определяем по координатам.
    // Номер строки считая заголовки дисков: у трека это idx + shift.
    property <int> hovered-row: self.has-hover && self.mouse-x >= row-x && self.mouse-x < self.width - 33px
        ? floor((self.mouse-y - flick.content-y - rows-y) / row-h) : -1;

    flick := Flickable {
        content-height: about
            ? (last-count > 0 ? last-rows-y + last-count * row-h + 16px : rows-y + about-box.height) + 32px
            : rows-y + (App.tracks.length + disk-rows) * row-h + (album && App.list-label != "" ? 80px : 32px);
        // Заголовки дисков выше первого видимого трека сдвигают его вниз: берём с запасом на их
        // число и рисуем на столько же строк больше.
        property <int> first: max(0, floor((-self.content-y - rows-y) / row-h) - disk-rows);
        property <int> shown-rows: about ? 0 : min(App.tracks.length - first, ceil(self.height / row-h) + 2 + disk-rows);

        Rectangle {
            y: 0;
            height: 340px;
            background: @linear-gradient(180deg, App.list-tint 0%, App.list-tint.with-alpha(0) 100%);
        }

        if plain: Text {
            x: pad + 2 * 32px + 8px + 16px;
            y: 12px;
            text: App.list-title;
            font-family: "YS Music Headline";
            font-size: 36px;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled;
        }
        if dislikes: HorizontalLayout {
            x: pad;
            y: 72px;
            height: 36px;
            spacing: 8px;
            alignment: start;
            Tab { text: T.t("Треки") + " • " + App.tracks.length; selected: true; }
            Tab { text: T.t("Исполнители"); clicked => { App.open-grid("disliked-artists", T.t("Мои дизлайки")); } }
        }

        Cover {
            visible: !plain;
            x: pad;
            y: 77px;
            width: 204px;
            height: 204px;
            radius: Theme.radius-size-m;
            round: artist;
            source: App.list-cover;
            cover-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.open-cover("list"); } }
            if own && (cover-ta.has-hover || poster-ta.has-hover): Rectangle {
                x: (parent.width - self.width) / 2;
                y: 156px;
                width: poster.preferred-width + 32px;
                height: 32px;
                border-radius: 16px;
                background: #1a1a1ae6;
                poster := Text {
                    text: App.list-cover.width > 0 ? T.t("Изменить обложку") : T.t("Добавить обложку");
                    font-size: Theme.font-size-label-m;
                    font-weight: 500;
                    color: #ffffff;
                }
            }
            poster-ta := TouchArea {
                x: 18px;
                y: 156px;
                width: 168px;
                height: 32px;
                enabled: own;
                mouse-cursor: MouseCursor.pointer;
                clicked => { App.list-change-cover(); }
            }
        }

        Text {
            visible: !plain;
            x: text-x;
            y: 85px;
            text: App.list-kind-label;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: Theme.controls-color-primary-text-enabled;
        }
        title := Text {
            x: text-x;
            y: 100px;
            visible: App.list-edit == 0 && !plain;
            width: min(self.preferred-width, parent.width - text-x - pad - (playlist && App.list-own ? 56px : 0px));
            height: 57px;
            text: App.list-title;
            overflow: elide;
            vertical-alignment: center;
            font-family: "YS Music Headline";
            font-size: Theme.font-size-headline-xxl;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled-variant;
        }
        title-ta := TouchArea {
            x: text-x;
            y: 100px;
            width: title.width + 56px;
            height: 57px;
            enabled: own && App.list-edit == 0;
        }
        if own && App.list-edit == 0 && title-ta.has-hover: Rectangle {
            x: text-x + title.width + 16px;
            y: 109px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: pencil-ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
            Icon { source: Icons.pencil; size: 20px; colorize: Theme.controls-color-secondary-on-default-enabled; }
            pencil-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.edit-title(); }
            }
        }
        if App.list-edit > 0: Rectangle {
            x: text-x;
            y: 105px;
            width: parent.width - text-x - 43px;
            height: 57px;
            border-radius: 2px;
            border-width: 1.6px;
            border-color: Theme.controls-color-primary-text-enabled;
        }
        title-field := Field {
            x: text-x + 2px;
            y: 105px;
            width: parent.width - text-x - 47px;
            height: 57px;
            visible: App.list-edit > 0;
            enabled: App.list-edit > 0;
            single-line: true;
            vertical-alignment: center;
            font-family: "YS Music Headline";
            font-size: Theme.font-size-headline-xxl;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled-variant;
            escape => { App.list-edit = 0; }
            accepted => {
                if App.list-edit == 1 {
                    App.list-edit = 0;
                    App.list-save-title(self.text);
                }
            }
            edited => {
                if self.text.character-count > 100 {
                    self.undo();
                }
            }
        }

        if album: HorizontalLayout {
            x: text-x;
            y: 166px;
            width: self.preferred-width;
            height: 20px;
            spacing: 6px;
            Cover { width: 20px; height: 20px; round: true; source: App.list-artist-cover; }
            ArtistLinks {
                width: self.content-width;
                names: App.list-artists;
                font-size: Theme.font-size-label-m;
                ink: Theme.controls-color-primary-text-enabled;
                ink-hover: Theme.controls-color-primary-text-hovered;
                clicked(i) => { App.list-open-artist(i); }
            }
            if App.list-year != "": Text {
                text: "  •  " + App.list-year;
                vertical-alignment: center;
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: Theme.controls-color-primary-text-enabled;
            }
        }
        one-line := Text {
            visible: false;
            text: "Ag";
            font-size: Theme.font-size-label-m;
            font-weight: 500;
        }
        desc := Text {
            visible: playlist && App.list-edit != 2;
            x: text-x;
            y: 162px + edit-shift;
            width: parent.width - text-x - pad;
            height: playlist ? min(self.preferred-height, 3 * one-line.preferred-height) : 0px;
            text: App.list-desc;
            wrap: word-wrap;
            overflow: elide;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: own && desc-ta.has-hover ? Theme.controls-color-primary-text-enabled-variant : Theme.controls-color-primary-text-enabled;
            desc-ta := TouchArea {
                enabled: own;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.edit-desc(); }
            }
        }
        if App.list-edit == 2: Rectangle {
            x: text-x;
            y: 168px;
            width: parent.width - text-x - 43px;
            height: 122px;
            border-radius: 2px;
            border-width: 1.6px;
            border-color: Theme.controls-color-primary-text-enabled;
            if desc-field.text == "": Text {
                x: 2px;
                y: 2px;
                text: T.t("Добавить описание") + "...";
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: Theme.controls-color-primary-text-enabled;
            }
        }
        desc-field := Field {
            x: text-x + 2px;
            y: 170px;
            width: parent.width - text-x - 47px;
            height: 118px;
            visible: App.list-edit == 2;
            enabled: App.list-edit == 2;
            single-line: false;
            wrap: word-wrap;
            escape => { App.list-edit = 0; }
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: Theme.controls-color-primary-text-enabled-variant;
            edited => {
                if self.text.character-count > 1000 {
                    self.undo();
                }
            }
        }
        if App.list-edit == 2: Rectangle {
            x: text-x;
            y: 302px;
            width: 114px;
            height: 40px;
            border-radius: 20px;
            background: save-ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
            Text { text: T.t("Сохранить"); font-size: Theme.font-size-label-s; font-weight: 500; color: Theme.controls-color-secondary-on-default-enabled; }
            save-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    App.list-edit = 0;
                    if title-field.text != App.list-title {
                        App.list-save-title(title-field.text);
                    }
                    App.list-save-desc(desc-field.text);
                }
            }
        }
        if App.list-edit == 2: Rectangle {
            x: text-x + 137px;
            y: 302px;
            width: 66px;
            height: 40px;
            Text {
                text: T.t("Отменить");
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: cancel-ta.has-hover ? Theme.controls-color-primary-text-enabled-variant : Theme.controls-color-primary-text-enabled;
            }
            cancel-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { App.list-edit = 0; } }
        }
        if !album && !plain: Text {
            x: text-x;
            y: short-head ? 162px : App.list-edit == 2 ? 374px : 190px + desc-extra + edit-shift;
            width: parent.width - text-x - pad;
            text: App.list-meta;
            overflow: elide;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: Theme.controls-color-primary-text-enabled;
        }

        if !plain: HorizontalLayout {
            x: text-x;
            y: buttons-y;
            height: 40px;
            spacing: 12px;
            HeaderButton { primary: true; icon: Icons.play-small; text: T.t("Слушать"); clicked => { App.play-list(0); } }
            if playlist: HeaderButton { icon: Icons.trailer-small; text: T.t("Трейлер"); clicked => { App.list-trailer(); } }
            if album: HeaderButton { icon: App.list-liked ? Icons.liked-small : Icons.like-small; text: App.list-likes; clicked => { App.list-like(); } }
            if playlist: HeaderButton { icon: App.list-liked ? Icons.liked-small : Icons.like-small; text: App.list-likes; clicked => { App.list-like(); } }
            HeaderButton { icon: App.pinned ? Icons.pin-filled-small : Icons.pin-small; clicked => { App.list-pin(); } }
            if !artist: HeaderButton {
                icon: Icons.more-small;
                clicked => { App.open-list-menu(self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height); }
            }
            if likes: HeaderButton { icon: Icons.download-small; clicked => { App.list-download(); } }
        }
        if playlist && App.list-own: Rectangle {
            x: parent.width - 45px - self.width;
            y: buttons-y;
            width: upload.preferred-width + 48px;
            height: 38px;
            border-radius: self.height / 2;
            background: up-ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
            animate background { duration: App.motion ? 150ms : 0ms; }
            upload := Text {
                text: T.t("Загрузить трек");
                font-size: Theme.font-size-label-s;
                font-weight: 500;
                color: Theme.controls-color-secondary-on-default-enabled;
            }
            up-ta := TouchArea { mouse-cursor: MouseCursor.pointer; }
        }

        if !album && !plain: Rectangle {
            x: pad;
            y: search-y;
            width: parent.width - pad - 47px;
            height: 34px;
            border-radius: 17px;
            border-width: 1px;
            border-color: field.has-focus ? Theme.controls-color-secondary-outline-hovered-stroke : Theme.controls-color-secondary-outline-enabled-stroke;
            Icon { x: 12px; source: Icons.search; size: 24px; colorize: Theme.controls-color-secondary-outline-enabled-stroke; }
            if App.list-filter == "": Text {
                x: 44px;
                text: T.t("Поиск трека");
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: Theme.controls-color-primary-text-enabled;
            }
            field := Field {
                x: 44px;
                width: parent.width - 80px;
                text <=> App.list-filter;
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: Theme.controls-color-primary-text-enabled-variant;
                vertical-alignment: center;
                edited => { App.filter-changed(self.text); }
            }
            property <bool> focused: field.has-focus;
            changed focused => { root.filter-focused = self.focused; }
            if App.list-filter != "": Icon {
                x: parent.width - 32px;
                source: Icons.close-small;
                size: 20px;
                colorize: Theme.controls-color-secondary-on-outline-enabled-variant;
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        App.list-filter = "";
                        App.filter-changed("");
                    }
                }
            }
        }

        if nonmusic: HorizontalLayout {
            x: pad;
            y: tabs-y;
            height: 40px;
            spacing: 4px;
            alignment: start;
            for t[i] in App.list-tabs: Tab {
                height: 40px;
                text: t;
                selected: App.list-tab == i;
                clicked => { App.list-tab = i; }
            }
        }

        // Вкладка «О …»: описание (`CommonAlbumPage_text`: 14/500, `primary-text-enabled_variant`,
        // не шире 60 % страницы, в окне уже 1060 — 70 %; 824 — та же граница по ширине страницы
        // при развёрнутом меню) и сведения (`NonMusicContent_infoBlock`: отступ сверху 8, подпись
        // цветом `primary-text-enabled` и 4 до значения). Снизу 16, если есть что показать.
        about-box := VerticalLayout {
            x: pad;
            y: rows-y;
            width: (parent.width - 2 * pad) * (root.width >= 824px ? 0.6 : 0.7);
            height: about ? self.preferred-height : 0px;
            visible: about;
            padding-bottom: App.list-desc != "" || App.list-about.length > 0 ? 16px : 0px;
            if App.list-desc != "": Text {
                text: App.list-desc;
                wrap: word-wrap;
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: Theme.controls-color-primary-text-enabled-variant;
            }
            for line in App.list-about: HorizontalLayout {
                padding-top: 8px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: line.title;
                    font-size: Theme.font-size-label-m;
                    font-weight: 500;
                    color: Theme.controls-color-primary-text-enabled;
                }
                // Издатели через запятую, с id — ссылки на страницу лейбла
                // (`CommonAlbumPage_labelLink`: подчёркнуты при наведении).
                for name[k] in line.items: Text {
                    text: name + (k < line.items.length - 1 ? "," : "");
                    overflow: elide;
                    font-size: Theme.font-size-label-m;
                    font-weight: 500;
                    color: Theme.controls-color-primary-text-enabled-variant;
                    if line.ids[k] != "" && link-ta.has-hover: Rectangle {
                        x: 0;
                        y: (parent.height + parent.font-size) / 2 + 1px;
                        width: parent.width - (k < line.items.length - 1 ? 4px : 0px);
                        height: 1px;
                        background: parent.color;
                    }
                    link-ta := TouchArea {
                        enabled: line.ids[k] != "";
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { App.open-grid("label:" + line.ids[k], name); }
                    }
                }
            }
        }

        // «Последние выпуски» (`entity-names.podcast-last-episodes`): заголовок h2 с отступом 16 + 10
        // слева (у описания 24), строки — как во вкладке выпусков.
        if last-count > 0: Text {
            x: pad + 2px;
            y: last-rows-y - 16px - 26px;
            height: 26px;
            text: T.t("Последние выпуски");
            vertical-alignment: center;
            font-family: "YS Music Headline";
            font-size: Theme.font-size-headline-m;
            font-weight: 700;
            color: Theme.controls-color-primary-text-enabled-variant;
        }
        for i in last-count: Rectangle {
            property <string> track-id: App.tracks[i].id;
            x: row-x;
            y: last-rows-y + i * row-h;
            width: parent.width - row-x - 33px;
            height: row-h;
            init => { App.request-cover(i); }
            changed track-id => { App.request-cover(i); }
            TrackRow {
                width: parent.width;
                hot: i == root.hovered-last;
                item: App.tracks[i];
                block: "list";
                index: i;
                open-card: true;
                current: i == App.list-current;
                play => { App.play-list(i); }
                like => { App.like-track(i); }
            }
        }

        if App.list-loading: Rectangle {
            x: row-x;
            y: rows-y;
            width: parent.width - row-x - 33px;
            height: 8 * row-h;
            for i in 8: Shimmer {
                x: 0;
                y: i * row-h + 8px;
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-size-s;
            }
        }

        // «Диск N», как `TextVolume_root` оригинала: строка высотой с трек
        // (`--album-page-track-height`), текст прижат к низу с отступом 16 и сдвинут на 8 слева;
        // шрифт `CommonAlbumPage_text` — label-m, 500, цвет `primary-text-enabled_variant`.
        for d in App.list-disks: Text {
            visible: !about;
            x: row-x + 8px;
            y: rows-y + d.slot * row-h + row-h - 16px - Theme.font-line-height-label-m;
            width: parent.width - row-x - 33px - 8px;
            height: Theme.font-line-height-label-m;
            text: d.text;
            overflow: elide;
            vertical-alignment: center;
            font-size: Theme.font-size-label-m;
            font-weight: 500;
            color: Theme.controls-color-primary-text-enabled-variant;
        }

        for k in max(0, shown-rows): Rectangle {
            property <int> idx: flick.first + k;
            property <string> track-id: App.tracks[idx].id;
            property <int> slot: idx + App.tracks[idx].shift;
            x: row-x;
            y: rows-y + slot * row-h;
            width: parent.width - row-x - 33px;
            height: row-h;
            init => { App.request-cover(idx); }
            changed idx => { App.request-cover(idx); }
            changed track-id => { App.request-cover(idx); }
            // Выпуски подкаста — с обложкой и датой, как `PodcastTrack` оригинала (модуль 76843); у
            // книги и сказки номер вместо обложки, как у музыкального альбома.
            if !album || App.list-podcast: TrackRow {
                width: parent.width;
                hot: parent.slot == root.hovered-row;
                item: App.tracks[idx];
                block: "list";
                index: idx;
                open-card: App.list-podcast;
                current: idx == App.list-current;
                removable: own;
                play => { App.play-list(idx); }
                like => { App.like-track(idx); }
                remove => { App.list-remove-track(idx); }
            }
            if album && !App.list-podcast: AlbumTrackRow {
                width: parent.width;
                hot: parent.slot == root.hovered-row;
                item: App.tracks[idx];
                current: idx == App.list-current;
                // После заголовка «Диск N» счёт снова с 1.
                pos: App.tracks[idx].num > 0 ? App.tracks[idx].num : idx + 1;
                block: "list";
                index: idx;
                play => { App.play-list(idx); }
                like => { App.like-track(idx); }
            }
        }

        if album && App.list-label != "": HorizontalLayout {
            x: pad;
            width: self.preferred-width;
            y: rows-y + (App.tracks.length + disk-rows) * row-h + 24px;
            height: 21px;
            spacing: 3px;
            Text { text: T.t("Лейбл:"); font-size: Theme.font-size-label-s; color: Theme.controls-color-primary-text-enabled; vertical-alignment: center; }
            Text {
                text: App.list-label;
                font-size: Theme.font-size-label-s;
                font-weight: 500;
                color: label-link.has-hover && label-link.enabled ? Theme.controls-color-primary-text-enabled : Theme.controls-color-primary-text-enabled-variant;
                vertical-alignment: center;
                label-link := TouchArea {
                    enabled: App.list-label-id != "";
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { App.open-grid("label:" + App.list-label-id, App.list-label); }
                }
            }
        }
    }
    ScrollBar {
        content-y <=> flick.content-y;
        content-height: flick.content-height;
        field-focused: (!album && filter-focused) || title-field.has-focus || desc-field.has-focus;
    }

    function edit-title() {
        title-field.text = App.list-title;
        App.list-edit = 1;
        title-field.focus();
        title-field.select-all();
    }

    function edit-desc() {
        if App.list-edit == 0 {
            title-field.text = App.list-title;
        }
        desc-field.text = App.list-desc-raw;
        App.list-edit = 2;
        desc-field.focus();
    }

    // Потеря фокуса полем названия сохраняет его, как в оригинале; Esc отменяет правку.
    changed has-title-focus => {
        if !has-title-focus && App.list-edit == 1 {
            App.list-edit = 0;
            App.list-save-title(title-field.text);
        }
    }
    property <bool> has-title-focus: title-field.has-focus;
    property <int> edit-request: App.list-edit-request;
    changed edit-request => {
        if edit-request == 1 {
            edit-title();
        } else if edit-request == 2 {
            edit-desc();
        }
        App.list-edit-request = 0;
    }
}

export component ListPage inherits Rectangle {
    ListContent { }
    NavArrows { x: 25px; y: 13px; }
}
